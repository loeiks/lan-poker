{
  "name": "lan-poker",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-language-service patch",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "test": "bun --bun x vitest run",
    "test:watch": "bun --bun x vitest",
    "dev": "bun run dev:server & bun run dev:client & wait",
    "dev:server": "PORT=1819 DB_FILENAME=\"./db/lan-poker-dev.sqlite\" bun run --hot server.ts",
    "dev:client": "vite dev",
    "build": "vite build",
    "start": "bun run server.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@effect/language-service": "^0.87.1",
    "@effect/vitest": "4.0.0-beta.102",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@types/bun": "^1.3.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.34",
    "@tanstack/router-plugin": "^1.168.23",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.102",
    "pokersolver": "^2.1.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
