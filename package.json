{
  "name": "lan-poker",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-language-service patch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun --bun x vitest run",
    "test:watch": "bun --bun x vitest",
    "dev": "DB_FILENAME=\"${TMPDIR:-/tmp}/lan-poker-dev.sqlite\" bun run --hot src/server/main.ts & vite dev & wait",
    "dev:server": "DB_FILENAME=\"${TMPDIR:-/tmp}/lan-poker-dev.sqlite\" bun run --hot src/server/main.ts",
    "dev:client": "vite dev",
    "build": "vite build",
    "start": "bun run src/server/main.ts"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.1",
    "@effect/vitest": "4.0.0-beta.102",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.102",
    "@effect/sql-sqlite-bun": "4.0.0-beta.102",
    "@fontsource-variable/inter": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.34",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-beta.102",
    "lucide-react": "^1.28.0",
    "pokersolver": "^2.1.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
